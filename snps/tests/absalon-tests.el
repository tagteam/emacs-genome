(ert-deftest absalon-save-new-file-backed-page-pushes-once ()
  (let ((absalon-write-enabled t)
        (absalon-confirm-writes nil)
        (file (make-temp-file "absalon-page-" nil ".org"))
        (creates 0)
        (updates 0)
        editor)
    (unwind-protect
        (save-window-excursion
          (setq editor (absalon-org-new-page "17" "New page"))
          (with-current-buffer editor
            (set-visited-file-name file t)
            (goto-char (point-max))
            (insert "New content\n")
            (cl-letf (((symbol-function 'absalon-create-page)
                       (lambda (&rest _)
                         (cl-incf creates)
                         '((url . "new-page"))))
                      ((symbol-function 'absalon-update-page)
                       (lambda (&rest _) (cl-incf updates))))
              (save-buffer)
              (should (= creates 1))
              (should (= updates 0))
              (should-not (buffer-modified-p))
              (with-temp-buffer
                (insert-file-contents file)
                (should (equal (absalon-org-keyword "ABSALON_PAGE_URL")
                               "new-page"))))))
      (when (buffer-live-p editor)
        (with-current-buffer editor (set-buffer-modified-p nil))
        (kill-buffer editor))
      (delete-file file))))

