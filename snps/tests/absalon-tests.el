(ert-deftest absalon-page-link-visits-and-reuses-org-editor ()
  (let ((absalon-current-course '((id . 42)))
        (fetches 0)
        editor)
    (unwind-protect
        (save-window-excursion
          (with-temp-buffer
            (org-mode)
            (insert absalon-test-page-link)
            (goto-char (point-min))
            (search-forward "When is time")
            (absalon--setup-page-editor)
            (cl-letf (((symbol-function 'absalon-page)
                       (lambda (course-id page-url)
                         (should (equal (list course-id page-url)
                                        '("95138" "when-is-time-zero")))
                         (cl-incf fetches)
                         '((url . "when-is-time-zero") (title . "Time zero")
                           (published . t) (body . "<p>Original content.</p>")))))
              (setq editor (call-interactively (key-binding (kbd "RET"))))
              (with-current-buffer editor
                (should (derived-mode-p 'org-mode))
                (should absalon-page-editor-mode)
                (should (memq #'absalon-push-page after-save-hook))
                (goto-char (point-max))
                (insert "Unsaved edits\n"))
              (with-temp-buffer
                (org-mode)
                (insert absalon-test-page-link)
                (goto-char (point-min))
                (should (eq editor (absalon-org-return))))
              (should (= fetches 1))
              (with-current-buffer editor
                (should (string-match-p "Unsaved edits" (buffer-string)))))))
      (when (buffer-live-p editor)
        (with-current-buffer editor (set-buffer-modified-p nil))
        (kill-buffer editor)))))

(ert-deftest absalon-page-link-creates-missing-page-at-linked-address ()
  (let ((absalon-write-enabled t)
        (absalon-confirm-writes t)
        (confirmations 0)
        calls editor)
    (unwind-protect
        (save-window-excursion
          (with-temp-buffer
            (org-mode)
            (insert absalon-test-page-link)
            (goto-char (point-min))
            (absalon--setup-page-editor)
            (cl-letf (((symbol-function 'absalon-request)
                       (lambda (path &optional method params)
                         (push (list path method params) calls)
                         (should (equal path "courses/95138/pages/when-is-time-zero"))
                         (if (equal method "PUT")
                             '((url . "when-is-time-zero") (title . "When is time zero?")
                               (published . :false) (body . ""))
                           (signal 'absalon-http-error '(404 "GET" "mock" "missing")))))
                      ((symbol-function 'yes-or-no-p)
                       (lambda (prompt)
                         (should (string-match-p "When is time zero" prompt))
                         (cl-incf confirmations)
                         t)))
              (setq editor (call-interactively (key-binding (kbd "RET"))))
              (should (= confirmations 1))
              (should (= (length calls) 2))
              (should (equal (nth 2 (car calls))
                             '(("wiki_page[title]" . "When is time zero?")
                               ("wiki_page[body]" . "")
                               ("wiki_page[published]" . "false"))))
              (with-current-buffer editor
                (should (equal (absalon-org-keyword "ABSALON_PAGE_URL") "when-is-time-zero"))
                (should (equal (absalon-org-keyword "ABSALON_PUBLISHED") "false"))))))
      (when (buffer-live-p editor) (kill-buffer editor)))))

(ert-deftest absalon-page-link-error-does-not-create ()
