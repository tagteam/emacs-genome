(ert-deftest absalon-files-view-refresh-retains-collapse ()
  (let (buffer)
    (unwind-protect
        (save-window-excursion
          (cl-letf (((symbol-function 'absalon-folders) (lambda (_) absalon-test-folders))
                    ((symbol-function 'absalon-files) (lambda (_) absalon-test-files)))
            (absalon-list-files "17")
            (setq buffer (current-buffer))
            (should (derived-mode-p 'absalon-files-mode))
            (should (eq (lookup-key (current-local-map) (kbd "+")) #'absalon-create-folder))
            (should (eq (lookup-key (current-local-map) (kbd "u")) #'absalon-upload-file))
            (should (equal absalon--file-folders absalon-test-folders))
            (goto-char (point-min))
            (absalon-files-toggle-folder)
            (should (equal (mapcar #'car tabulated-list-entries) '("folder:1" "file:11")))
            (absalon-view-refresh)
            (should (member "1" absalon--collapsed-folders))
            (should (= (length tabulated-list-entries) 2))
            (absalon-files-open)
            (should (= (length tabulated-list-entries) 7))
            (should-not absalon--collapsed-folders)))
      (when (buffer-live-p buffer) (kill-buffer buffer)))))

