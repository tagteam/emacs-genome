(ert-deftest absalon-upload-selected-folder ()
  (let ((file (make-temp-file "absalon-upload-" nil ".txt"))
        (absalon-current-course '((id . 17)))
        (absalon-write-enabled t)
        (absalon-confirm-writes nil)
        selected calls transferred)
    (unwind-protect
        (cl-letf (((symbol-function 'read-file-name) (lambda (&rest _) file))
                  ((symbol-function 'absalon--read-folder-id)
                   (lambda (course-id &optional _)
                     (setq selected course-id)
                     "4"))
                  ((symbol-function 'absalon-request)
                   (lambda (path method params)
                     (push (list path method params) calls)
                     '((upload_url . "https://uploads.example.org")
                       (upload_params . ((key . "upload-key"))))))
                  ((symbol-function 'absalon--curl-multipart)
                   (lambda (url params uploaded-file)
                     (setq transferred (list url params uploaded-file))
                     '((id . 10) (folder_id . 4)))))
