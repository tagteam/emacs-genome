(ert-deftest absalon-page-editor-save-and-reuse ()
  (let ((absalon-current-course '((id . 17) (name . "Original")))
        (absalon-write-enabled t)
        (absalon-confirm-writes nil)
        (fetches 0)
        updates editor)
    (unwind-protect
        (save-window-excursion
          (cl-letf (((symbol-function 'absalon-page)
                     (lambda (course-id page-url)
                       (should (equal (list course-id page-url) '("17" "intro")))
                       (cl-incf fetches)
                       '((title . "Intro") (url . "intro")
                         (published . t) (body . "<p>Old text</p>"))))
                    ((symbol-function 'absalon-update-page)
                     (lambda (course-id page-url _title body _published)
                       (push (list course-id page-url body) updates)))
                    ((symbol-function 'read-file-name)
                     (lambda (&rest _) (ert-fail "Unexpected save-file prompt"))))
            (setq editor (absalon-edit-page "17" "intro"))
            (with-current-buffer editor
              (should (local-variable-p 'after-save-hook))
              (should (memq #'absalon-push-page after-save-hook))
              (goto-char (point-max))
              (insert "\nEdited in Org.\n"))
            (should (eq editor (absalon-edit-page "17" "intro")))
            (should (= fetches 1))
            (setq absalon-current-course '((id . 42) (name . "Other")))
            (with-current-buffer editor
              (save-buffer)
              (should-not buffer-file-name)
              (should-not (buffer-modified-p))
              (should (= (length updates) 1))
              (should (equal (seq-take (car updates) 2) '("17" "intro")))
              (should (string-match-p "Edited in Org" (nth 2 (car updates))))
              (save-buffer)
              (should (= (length updates) 1))))
          (with-temp-buffer
            (org-mode)
            (should-not (memq #'absalon-push-page after-save-hook))))
      (when (buffer-live-p editor)
        (with-current-buffer editor (set-buffer-modified-p nil))
        (kill-buffer editor)))))

(ert-deftest absalon-page-editor-save-failure-can-retry ()
  (let ((absalon-write-enabled nil)
        (absalon-confirm-writes nil)
        editor)
    (unwind-protect
        (save-window-excursion
          (cl-letf (((symbol-function 'absalon-page)
                     (lambda (&rest _)
                       '((title . "Retry") (url . "retry")
                         (published . :false) (body . "<p>Old text</p>")))))
            (setq editor (absalon-edit-page "17" "retry"))
            (with-current-buffer editor
              (goto-char (point-max))
              (insert "\nChange\n")
              (should-error (save-buffer) :type 'user-error)
              (should (buffer-modified-p))
              (let ((absalon-write-enabled t))
                (let ((absalon-confirm-writes t))
                  (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) nil))
                            ((symbol-function 'absalon-update-page)
                             (lambda (&rest _) (ert-fail "Cancelled push sent"))))
                    (should-error (save-buffer) :type 'user-error)
                    (should (buffer-modified-p))))
                (cl-letf (((symbol-function 'absalon-update-page)
                           (lambda (&rest _) (error "Network error"))))
                  (should-error (save-buffer))
                  (should (buffer-modified-p)))
                (cl-letf (((symbol-function 'absalon-update-page)
                           (lambda (&rest _) '((url . "retry")))))
                  (save-buffer)
                  (should-not (buffer-modified-p)))))))
      (when (buffer-live-p editor)
        (with-current-buffer editor (set-buffer-modified-p nil))
        (kill-buffer editor)))))

