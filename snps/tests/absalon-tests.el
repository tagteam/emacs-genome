          (should returned))))))

(defun absalon-test-goto-row (id)
  "Move to file tree row ID."
  (goto-char (point-min))
  (while (and (not (eobp)) (not (equal id (tabulated-list-get-id))))
    (forward-line 1))
  (should (equal id (tabulated-list-get-id))))

(ert-deftest absalon-file-open-dispatch ()
  (dolist (name '("analysis.R" "lesson.Rmd" "data.csv" "archive.zip"
                  "page.HTML" "slides.pdf"))
    (with-temp-buffer
      (absalon-files-mode)
      (setq tabulated-list-format absalon--files-format
            absalon--file-objects `(((id . 1) (filename . ,name))))
      (absalon--render-file-tree)
      (goto-char (point-min))
      (let (action)
        (cl-letf (((symbol-function 'absalon-view-browse)
                   (lambda () (setq action 'browser)))
                  ((symbol-function 'absalon-files-open-in-emacs)
                   (lambda () (setq action 'emacs))))
          (absalon-files-open)
          (should (eq action (if (member name '("page.HTML" "slides.pdf"))
                                 'browser 'emacs))))))))

(ert-deftest absalon-file-marks-survive-collapse-and-refresh ()
  (with-temp-buffer
    (absalon-files-mode)
    (setq tabulated-list-format absalon--files-format
          absalon--file-folders absalon-test-folders
          absalon--file-objects absalon-test-files)
    (absalon--render-file-tree)
    (absalon-test-goto-row "folder:2")
    (absalon-files-toggle-folder)
    (absalon-files-mark)
    (should (equal absalon--marked-files '("10")))
    (should-not (assoc "file:10" tabulated-list-entries))
    (absalon-files-toggle-folder)
    (absalon-test-goto-row "file:10")
    (should (eq (char-after (line-beginning-position)) ?*))
    (absalon--render-file-tree)
    (should (eq (char-after (line-beginning-position)) ?*))
    (absalon-test-goto-row "folder:2")
    (absalon-files-mark)
    (should-not absalon--marked-files)
    (absalon-test-goto-row "folder:1")
    (absalon-files-mark)
    (should (= (length absalon--marked-files) 2))
    (absalon-files-unmark-all)
    (should-not absalon--marked-files)))

(ert-deftest absalon-file-relative-path-validation ()
  (let ((absalon--file-folders absalon-test-folders))
    (should (equal (absalon--file-relative-path (car absalon-test-files)) "root.txt"))
    (should (equal (absalon--file-relative-path (cadr absalon-test-files))
                   "Week 1/Slides/slides.pdf"))
    (should-error (absalon--file-relative-path (nth 2 absalon-test-files))
                  :type 'user-error)
    (dolist (name '("../secret" "/tmp/secret" ".." "a\\b" ""))
      (should-error (absalon--file-relative-path `((display_name . ,name)))
                    :type 'user-error))
    (let ((absalon--file-folders '(((id . 1) (name . "Loop") (parent_folder_id . 1)))))
      (should-error (absalon--file-relative-path '((folder_id . 1) (filename . "a.R")))
                    :type 'user-error))))

(ert-deftest absalon-download-preserves-bytes-and-does-not-forward-token ()
  (let* ((directory (make-temp-file "absalon-test-" t))
         (destination (expand-file-name "data.bin" directory))
         (payload (unibyte-string 13 10 0 255 128 65 10))
         (url-request-extra-headers '(("Authorization" . "SECRET")))
         response)
    (unwind-protect
        (cl-letf (((symbol-function 'absalon-request)
                   (lambda (path &rest _)
                     (should (equal path "files/10"))
                     '((url . "https://download.example/file?verifier=test"))))
                  ((symbol-function 'url-retrieve-synchronously)
                   (lambda (url &rest _)
                     (should (equal url "https://download.example/file?verifier=test"))
                     (should-not url-request-extra-headers)
                     (setq response (generate-new-buffer " *download-test*"))
                     (with-current-buffer response
                       (set-buffer-multibyte nil)
                       (insert "HTTP/1.1 200 OK\r\nContent-Type: application/octet-stream\r\n\r\n")
                       (insert payload)
                       (setq-local url-http-response-status 200))
                     response)))
          (absalon--download-file '((id . 10)) destination)
          (with-temp-buffer
            (set-buffer-multibyte nil)
            (insert-file-contents-literally destination)
            (should (equal (buffer-string) payload)))
          (should-not (buffer-live-p response))
          (should (equal (directory-files directory nil "^[^.]") '("data.bin"))))
      (when (buffer-live-p response) (kill-buffer response))
      (delete-directory directory t))))

(ert-deftest absalon-download-failure-preserves-existing-file ()
  (let ((destination (make-temp-file "absalon-test-" nil nil "original")) response)
    (unwind-protect
        (cl-letf (((symbol-function 'absalon-request)
                   (lambda (&rest _) '((url . "https://download.example/file"))))
                  ((symbol-function 'url-retrieve-synchronously)
                   (lambda (&rest _)
                     (setq response (generate-new-buffer " *download-test*"))
                     (with-current-buffer response
                       (insert "HTTP/1.1 403 Forbidden\r\n\r\nError")
                       (setq-local url-http-response-status 403))
                     response)))
          (should-error (absalon--download-file '((id . 1)) destination)
                        :type 'absalon-http-error)
          (should-not (buffer-live-p response))
          (with-temp-buffer
            (insert-file-contents destination)
            (should (equal (buffer-string) "original"))))
      (when (buffer-live-p response) (kill-buffer response))
      (delete-file destination))))

(ert-deftest absalon-download-selection-and-all-preserve-paths ()
  (let ((directory (make-temp-file "absalon-test-" t)))
    (unwind-protect
        (with-temp-buffer
          (absalon-files-mode)
          (setq tabulated-list-format absalon--files-format
                absalon--file-folders absalon-test-folders
                absalon--file-objects (seq-take absalon-test-files 2)
                absalon--marked-files '("10")
                absalon--collapsed-folders '("1"))
          (let (paths)
            (cl-letf (((symbol-function 'absalon--download-file)
                       (lambda (_file path) (push (file-relative-name path directory) paths))))
              (absalon-files-download-marked directory)
              (should (equal paths '("Week 1/Slides/slides.pdf")))
              (setq paths nil)
              (absalon-files-download-marked directory t)
              (should (equal (sort paths #'string-lessp)
                             '("Week 1/Slides/slides.pdf" "root.txt")))
              (absalon-files-unmark-all)
              (should-error (absalon-files-download-marked directory) :type 'user-error))))
      (delete-directory directory t))))

(ert-deftest absalon-download-refuses-collisions-and-symlink-escape ()
  (let ((directory (make-temp-file "absalon-test-" t))
        (outside (make-temp-file "absalon-outside-" t)))
    (unwind-protect
        (with-temp-buffer
          (absalon-files-mode)
          (setq absalon--file-folders absalon-test-folders
                absalon--file-objects (list (car absalon-test-files) (car absalon-test-files)))
          (cl-letf (((symbol-function 'absalon--download-file)
                     (lambda (&rest _) (ert-fail "Unexpected download"))))
            (should-error (absalon-files-download-marked directory t) :type 'user-error)
            (setq absalon--file-objects (list (cadr absalon-test-files)))
            (make-symbolic-link outside (expand-file-name "Week 1" directory))
            (should-error (absalon-files-download-marked directory t) :type 'user-error)))
      (delete-directory directory t)
      (delete-directory outside t))))

(ert-deftest absalon-open-local-copy-preserves-unsaved-edits ()
  (let ((absalon--file-cache-directory (make-temp-file "absalon-test-" t))
        (downloads 0) opened)
    (unwind-protect
        (save-window-excursion
          (with-temp-buffer
            (absalon-files-mode)
            (setq tabulated-list-format absalon--files-format
                  absalon--file-objects '(((id . 1) (filename . "example.txt"))))
            (absalon--render-file-tree)
            (goto-char (point-min))
            (let ((tree (current-buffer)))
              (cl-letf (((symbol-function 'absalon--download-file)
                         (lambda (_file path)
                           (cl-incf downloads)
                           (make-directory (file-name-directory path) t)
                           (write-region "original" nil path nil 'silent))))
                (absalon-files-open-in-emacs)
                (setq opened (current-buffer))
                (should (equal (file-name-nondirectory buffer-file-name) "example.txt"))
                (goto-char (point-max))
                (insert " edits")
                (with-current-buffer tree (absalon-files-open-in-emacs))
                (should (= downloads 1))
                (with-current-buffer opened
                  (should (equal (buffer-string) "original edits")))))))
      (when (buffer-live-p opened)
        (with-current-buffer opened (set-buffer-modified-p nil))
        (kill-buffer opened))
      (delete-directory absalon--file-cache-directory t))))

