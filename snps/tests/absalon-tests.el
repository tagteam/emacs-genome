(ert-deftest absalon-page-link-parsing-and-org-return-fallback ()
  (dolist (text '("[[https://absalon.ku.dk/courses/95138/pages/caf%C3%A9?module_item_id=5#intro][Cafe]]"
                  "[[https://absalon.ku.dk/courses/95138/pages/caf%C3%A9/][Cafe]]"))
