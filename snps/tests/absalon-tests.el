(ert-deftest absalon-create-module-write-guard ()
  (let ((absalon-write-enabled nil))
    (cl-letf (((symbol-function 'absalon-request)
               (lambda (&rest _) (ert-fail "Unexpected API request"))))
      (should-error (absalon-create-module "17" "Week 1")
                    :type 'user-error))))

(ert-deftest absalon-create-module-request ()
  (let ((absalon-write-enabled t)
        calls)
    (cl-letf (((symbol-function 'absalon-request)
               (lambda (path method params)
                 (push (list path method params) calls)
                 '((id . 28) (name . "Week 1")))))
      (should (equal (absalon-create-module "17" "Week 1" 2)
                     '((id . 28) (name . "Week 1"))))
      (should (equal (car calls)
                     '("courses/17/modules" "POST"
                       (("module[name]" . "Week 1")
                        ("module[position]" . 2)))))
      (absalon-create-module "17" "Week 2")
      (should (equal (nth 2 (car calls))
                     '(("module[name]" . "Week 2")))))))

(ert-deftest absalon-creation-rejects-invalid-input ()
  (cl-letf (((symbol-function 'absalon-request)
             (lambda (&rest _) (ert-fail "Unexpected API request"))))
    (should-error (absalon-create-module "17" "  ") :type 'user-error)
    (should-error (absalon-create-module "" "Week 1") :type 'user-error)
    (dolist (position '(0 -1 1.5 "2"))
      (should-error (absalon-create-module "17" "Week 1" position)
                    :type 'user-error))
    (should-error (absalon-org-new-page "17" "Topic\n#+TITLE: Other")
                  :type 'user-error)
    (should-error (absalon-org-new-page "17" "Topic" nil 2)
                  :type 'user-error)))

(ert-deftest absalon-new-page-draft-and-push ()
  (let ((absalon-write-enabled nil)
        (absalon-confirm-writes nil)
        draft calls)
    (unwind-protect
        (save-window-excursion
          (cl-letf (((symbol-function 'absalon-request)
                     (lambda (path method params)
                       (push (list path method params) calls)
                       (pcase path
                         ("courses/17/pages" '((url . "topic")))
                         ("courses/17/modules/28/items"
                          '((id . 39) (position . 3)))
                         (_ (ert-fail (format "Unexpected request: %s" path))))))
                    ((symbol-function 'absalon-module-items)
                     (lambda (course-id module-id)
                       (should (equal (list course-id module-id) '("17" "28")))
                       nil)))
            (setq draft (absalon-org-new-page "17" "Topic" "28" 3))
            (with-current-buffer draft
              (should (derived-mode-p 'org-mode))
              (should (equal (absalon-org-keyword "ABSALON_MODULE_ID") "28"))
              (should (equal (absalon-org-keyword "ABSALON_POSITION") "3"))
              (should (equal (absalon-org-keyword "ABSALON_PUBLISHED") "false"))
              (should-not (absalon-org-keyword "ABSALON_PAGE_URL"))
              (should-not calls)
              (insert "* Introduction\n\nHello *class*.\n")
              (should-error (absalon-org-push-page) :type 'user-error)
              (should-not calls)
              (let ((absalon-write-enabled t))
                (absalon-org-push-page))
              (should (equal (absalon-org-keyword "ABSALON_PAGE_URL") "topic"))
              (should (= (length calls) 2))
              (let ((page-params (nth 2 (cadr calls)))
                    (item-params (nth 2 (car calls))))
                (should (equal (cdr (assoc "wiki_page[title]" page-params)) "Topic"))
                (should (equal (cdr (assoc "wiki_page[published]" page-params)) "false"))
                (should (string-match-p "<b>class</b>"
                                        (cdr (assoc "wiki_page[body]" page-params))))
                (should (equal item-params
                               '(("module_item[type]" . "Page")
                                 ("module_item[page_url]" . "topic")
                                 ("module_item[position]" . 3))))))))
      (when (buffer-live-p draft) (kill-buffer draft)))))

