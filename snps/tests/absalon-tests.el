(ert-deftest absalon-file-tree-hierarchy-and-collapse ()
  (let* ((data (absalon--file-tree-data absalon-test-folders absalon-test-files nil))
         (rows (car data))
         (table (cdr data)))
    (should (equal (mapcar #'car rows)
                   '("folder:1" "folder:2" "folder:4" "file:10"
                     "folder:3" "file:2" "file:11")))
    (should (equal (aref (cadr (assoc "folder:4" rows)) 0) "    [-] Slides/"))
    (should (equal (aref (cadr (assoc "file:10" rows)) 0) "          slides.pdf"))
    (should (equal (cdr (assoc "folder:2" table)) (nth 3 absalon-test-folders)))
    (should (equal (cdr (assoc "file:2" table)) (car absalon-test-files))))
  (let ((rows (car (absalon--file-tree-data absalon-test-folders absalon-test-files '("2")))))
    (should (equal (mapcar #'car rows)
                   '("folder:1" "folder:2" "folder:3" "file:2" "file:11")))
    (should (equal (aref (cadr (assoc "folder:2" rows)) 0) "  [+] Week 1/"))))

